{% extends "partials/base.html.twig" %}

{% set pageTitle = "Profile" %}
{% set currentRoute = "profile" %}

{% block content %}
    <section class="d-flex align-items-start justify-content-between mx-auto gap-5 mt-4" id="profile-main">
        <article class="profile-block w-25 p-4 position-relative">
            <a href="/profile/edit" class="top-0 end-0 m-3 btn btn-glass-primary">Edit Profile</a>

            <h3>{{ profile.name }}</h3>

            <p class="mb-4">
                {{ profile.bio|replace({'{age}': profile.getAge()}) }}
            </p>

            <h4>Characteristics</h4>
            <div class="d-flex flex-wrap gap-2 mb-4">
                {% for characteristic in profile.characteristics|split(',') %}
                    {% if characteristic|trim is not empty %}
                        <span class="badge rounded-pill glass-pill">{{ characteristic|trim }}</span>
                    {% endif %}
                {% endfor %}
            </div>

            <h4>Skills</h4>
            <div class="d-flex flex-wrap gap-2 mb-4">
                {% for skill in profile.skills|split(',') %}
                    {% if skill|trim is not empty %}
                        <span class="badge rounded-pill glass-pill">{{ skill|trim }}</span>
                    {% endif %}
                {% endfor %}
            </div>

            <h4>Socials</h4>
            <ul class="list-unstyled mb-0">
                {% if profile.linkedin_url %}
                    <li class="mb-2">
                        <a target="_blank" rel="noopener noreferrer" href="{{ profile.linkedin_url }}">LinkedIn</a>
                    </li>
                {% endif %}
                {% if profile.github_url %}
                    <li>
                        <a target="_blank" rel="noopener noreferrer" href="{{ profile.github_url }}">Github</a>
                    </li>
                {% endif %}
            </ul>
        </article>

        <article class="profile-block w-75 p-4 align-center d-flex justify-content-center">
            <div id="profile-carousel" class="carousel slide w-100" data-bs-ride="carousel">
                <div class="carousel-indicators">
                    <button type="button" data-bs-target="#profile-carousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                    <button type="button" data-bs-target="#profile-carousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
                    <button type="button" data-bs-target="#profile-carousel" data-bs-slide-to="2" aria-label="Slide 3"></button>
                </div>

                <div class="carousel-inner rounded">
                    <div class="carousel-item active">
                        <img src="/images/pasimohomepage.png" alt="Pasimo homepage" class="d-block w-100 carousel-img">
                    </div>
                    <div class="carousel-item">
                        <img src="/images/qrgoatslogin.png" alt="QR-Goats login" class="d-block w-100 carousel-img">
                    </div>
                    <div class="carousel-item">
                        <img src="/images/minesweeper.png" alt="Minesweeper" class="d-block w-100 carousel-img">
                    </div>
                </div>

                <button class="carousel-control-prev" type="button" data-bs-target="#profile-carousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#profile-carousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            </div>
        </article>
    </section>
{% endblock %}