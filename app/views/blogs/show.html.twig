{% extends "blogs/base.twig" %}

{% set pageTitle = blog.title %}
{% set blogTitle = blog.title %}
{% set blogSubtitle = blog.subtitle %}
{% set blogPublished = blog.published %}

{% block blog_content %}
    <div class="row justify-content-center mt-4">
        <div class="col-md-10">
            {% if blog.header_image %}
                <img src="{{ blog.header_image }}" alt="Header">
            {% endif %}

            {{ blog.content|raw }}

            <div class="blog-actions-footer d-flex align-items-center mt-5">
                <form action="/blogs/{{ blog.slug }}/toggle-publish" method="POST" class="m-0 me-2">
                    <button type="submit" class="btn {% if blog.published %}btn-glass-warning{% else %}btn-glass-success{% endif %}">
                        {% if blog.published %}
                            Unpublishs
                        {% else %}
                            Publish
                        {% endif %}
                    </button>
                </form>
                <a href="/blogs/{{ blog.slug }}/edit" class="btn btn-glass-primary me-2">Edit Post</a>
                <a href="/blogs/{{ blog.slug }}/delete" class="btn btn-red btn-glass-danger">Delete Post</a>
            </div>
        </div>
    </div>
{% endblock %}
