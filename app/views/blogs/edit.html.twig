{% extends "partials/base.html.twig" %}

{% set pageTitle = "Edit Blog" %}

{% block extra_css %}
<link href="https://cdn.jsdelivr.net/npm/quill@2.0.0/dist/quill.snow.css" rel="stylesheet" />
{% endblock %}

{% block content %}
    <div class="w-50 mx-auto mt-5 profile-block p-4 glass-text">
        <h2 class="mb-4">Edit Blog Post</h2>

        <form method="POST" action="/blogs/{{ blog.slug }}/edit" class="glass-form" id="blogForm">
            <div class="mb-3">
                <label for="title" class="form-label">Title</label>
                <input type="text" class="form-control" id="title" name="title" value="{{ blog.title }}" required>
            </div>

            <div class="mb-3">
                <label for="subtitle" class="form-label">Subtitle</label>
                <input type="text" class="form-control" id="subtitle" name="subtitle" value="{{ blog.subtitle }}" required>
            </div>

            <div class="mb-3">
                <label for="preview_image" class="form-label">Preview Image URL</label>
                <input type="text" class="form-control" id="preview_image" name="preview_image" value="{{ blog.preview_image }}" placeholder="Preview image URL" required>
            </div>

            <div class="mb-3">
                <label for="header_image" class="form-label">Header Image URL</label>
                <input type="text" class="form-control" id="header_image" name="header_image" value="{{ blog.header_image }}" placeholder="Header image URL" >
            </div>

            <div class="mb-4 form-check">
                <input type="checkbox" class="form-check-input" id="published" name="published" value="1" {% if blog.published %}checked{% endif %}>
                <label class="form-check-label" for="published">Publish this blog post</label>
            </div>

            <div class="mb-4">
                <label for="editor" class="form-label">Content</label>
                <div id="editor">{{ blog.content|raw }}</div>
                <input type="hidden" name="content" id="content">
            </div>

            <button type="submit" class="btn btn-glass-primary w-100 mt-3">Update Post</button>
        </form>
    </div>
{% endblock %}

{% block extra_js %}
<script src="https://cdn.jsdelivr.net/npm/quill@2.0.0/dist/quill.js"></script>
<script>
    const quill = new Quill('#editor', {
        theme: 'snow'
    });

    const form = document.getElementById('blogForm');
    form.onsubmit = function() {
        const content = document.querySelector('input[name=content]');
        content.value = quill.root.innerHTML;
    };
</script>
{% endblock %}