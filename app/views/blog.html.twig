{% extends "partials/base.html.twig" %}

{% set pageTitle = "Blog" %}
{% set currentRoute = "blog" %}

{% block content %}
    <section class="w-75 mx-auto mt-4">
        <div class="d-flex justify-content-between align-items-center mb-5">
            <h1 class="m-0"> Latest blogs </h1>
            <a href="/blogs/create" class="btn text-white">Write New Blog</a>
        </div>

        <div class="row justify-content-center">
            {% for blog in blogs %}
                <article class="col-md-7 mb-3">
                    <button onclick="window.location.href='/blogs/{{ blog.slug }}'" class="w-100 p-3 blog-button text-start">
                        <div class="d-flex align-items-center mb-2">
                            <img src="{{ blog.preview_image }}" alt="Preview" class="blog-image me-3 rounded">
                            <h5 class="mb-0"> {{ blog.title }} </h5>
                        </div>
                        <p class="mb-0 text-muted">
                            {{ blog.subtitle }}
                        </p>
                    </button>
                </article>
            {% else %}
                <p class="text-center">No blogs found.</p>
            {% endfor %}
        </div>
    </section>
{% endblock %}
